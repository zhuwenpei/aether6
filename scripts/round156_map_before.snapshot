export const SYNOPTIC_TITLE_MODEL_LABEL = "AETHER SIM";
export type SynopticWindPressureStyle = "default" | "hmon" | "hwrf";

export interface SynopticWindPressureRenderCache {
  computationCache: SynopticComputationCache;
  rasterCanvas?: HTMLCanvasElement;
  rasterImageData?: ImageData;
  contourValues?: Float32Array;
  contourNx?: number;
  contourNy?: number;
  contourCellMin?: Float32Array;
  contourCellMax?: Float32Array;
  /** Stencil extrema depend only on the solved scalar grid, not on the output pixel. */
  envelopeByField?: WeakMap<SynopticWindField, WindEnvelope>;
  /** The same static coastline paths are reused on every frame of a fixed-crop video. */
  fixedCoastPaths?: { key: string; paths: Path2D[] };
  /** Raster-space lat/lon coordinates reused when the fixed map rectangle is unchanged. */
  rasterCoords?: { key: string; lons: Float64Array; lats: Float64Array };
}

export function createSynopticWindPressureRenderCache(): SynopticWindPressureRenderCache {
  return { computationCache: createSynopticComputationCache() };
}

export interface SynopticWindPressureMapOptions {
  canvas: HTMLCanvasElement;
  typhoons: Typhoon[];
  primaryTyphoon: Typhoon;
  initHour: number;
  validHour: number;
  startDate: Date;
  config?: SimulationConfig;
  modelLabel?: string;
  stylePreset?: SynopticWindPressureStyle;
  aspectRatio?: SynopticProductAspect;
  /** Opt-in rounded, clearer existing eyes (default false). */
  roundedClearEye?: boolean;
  domainMode?: "reference" | "follow_storm" | "custom";
  customBounds?: { lonMin: number; lonMax: number; latMin: number; latMax: number };
  contourIntervalHpa?: number;
  showContours?: boolean;
  gridResolutionDeg?: 0.1 | 0.125 | 0.25 | 0.5;
  /** 地图倍率：1 为基准范围，>1 放大、<1 缩小。 */
  mapZoom?: number;
  outputWidth: number;
  showTrackOverlay?: boolean;
  /** forecast=预报产品；record=台风报告历史复盘产品。 */
  timePresentation?: "forecast" | "record";
  onProgress?: (v: number) => void;
  signal?: AbortSignal;
  /** Reused across video frames to avoid forecast/path and canvas buffer recomputation. */
  renderCache?: SynopticWindPressureRenderCache;
  /** Full forecast horizon for one-time path materialization in video generation. */
  forecastHorizonHours?: number;
}

