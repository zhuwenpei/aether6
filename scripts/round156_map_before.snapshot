const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
const smooth01 = (v: number) => {
  const x = clamp(v, 0, 1);
  return x * x * (3 - 2 * x);
};
const checkAbort = (signal?: AbortSignal) => {
  if (signal?.aborted) throw new DOMException("Generation cancelled", "AbortError");
};
const yieldUi = yieldSynopticUi;

function radiusAtBearing(quad: { ne?: number; se?: number; sw?: number; nw?: number } | undefined, bearingDeg: number, fallback: number) {
  if (!quad) return fallback;
  const values = [quad.ne || fallback, quad.se || fallback, quad.sw || fallback, quad.nw || fallback, quad.ne || fallback];
  const centers = [45, 135, 225, 315, 405];
  let b = ((bearingDeg % 360) + 360) % 360;
  if (b < 45) b += 360;
  for (let i = 0; i < 4; i++) if (b <= centers[i + 1]) {
    const q = clamp((b - centers[i]) / 90, 0, 1);
    const t = 0.5 - 0.5 * Math.cos(Math.PI * q);
    return values[i] * (1 - t) + values[i + 1] * t;
  }
  return fallback;
}

function offsetLatLon(lat: number, lon: number, bearingDeg: number, distanceKm: number) {
  const a = bearingDeg * Math.PI / 180;
  const dLat = Math.cos(a) * distanceKm / 111.12;
  const dLon = Math.sin(a) * distanceKm / (111.12 * Math.max(0.18, Math.cos(lat * Math.PI / 180)));
  return { lat: lat + dLat, lon: lon + dLon };
}

function meanRadius(r?: { ne: number; se: number; sw: number; nw: number }) {
  if (!r) return 220;
  const a = [r.ne, r.se, r.sw, r.nw].filter((v) => Number.isFinite(v) && v > 0);
  return a.length ? a.reduce((x, y) => x + y, 0) / a.length : 220;
}

function forecastIssueSnapshot(storm: Typhoon, initHour: number): Typhoon | any {
  const liveHour = typeof storm.simHour === "number" ? storm.simHour : null;
  if (liveHour !== null && Number.isFinite(liveHour)) {
    const liveTimelineHour = Math.floor(liveHour + 1e-6);
    if (initHour >= liveTimelineHour - 1e-6 && initHour <= liveHour + 0.25) return storm;
  }
  let issue: Typhoon | any = null;
  for (const h of storm.history || []) {
    if (h.simHour <= initHour + 1e-6 && (!issue || h.simHour > issue.simHour)) issue = mergeTyphoonStateWithCurrentIdentity(storm, h);
  }
  if (issue) return issue;
  const first=(storm.history||[]).reduce<any>((a,h)=>!a||h.simHour<a.simHour?mergeTyphoonStateWithCurrentIdentity(storm,h):a,null);
  return first||storm;
}

function forecastAnchor(
  storm: Typhoon, initHour: number, validHour: number, config?: SimulationConfig,
  computationCache?: SynopticComputationCache, forecastHorizonHours?: number
) {
  // 5.2.30：取景中心与真正生成风场时使用完全相同的 materialize 预报状态，
  // 不再从可能过期的 issue.forecastPath 猜中心，修复“跟随中心却偏到远处”。
  const cfg = { ...DEFAULT_CONFIG, ...(config || storm.configSnapshot || {}) } as SimulationConfig;
  const resolved = resolveSynopticStormAtHour(storm, initHour, validHour, cfg, computationCache, forecastHorizonHours)?.state;
  if (resolved) return { lat: resolved.lat, lon: resolved.lon, r7: resolved.r7 || storm.r7 };
  const issue = forecastIssueSnapshot(storm, initHour);
  return { lat: issue.lat, lon: issue.lon, r7: issue.r7 || storm.r7 };
}

export function computeSynopticDisplayBounds(options: Pick<SynopticWindPressureMapOptions, "primaryTyphoon" | "initHour" | "validHour" | "domainMode" | "customBounds" | "config" | "mapZoom" | "renderCache" | "forecastHorizonHours" | "stylePreset" | "aspectRatio">): SynopticBounds {
  const anchor = forecastAnchor(
    options.primaryTyphoon, options.initHour, options.validHour, options.config,
    options.renderCache?.computationCache, options.forecastHorizonHours
  );
  const mode = options.domainMode || "reference";
  const frameRect = referencePanelLayout(options.stylePreset, options.aspectRatio).map;
  const aspect = frameRect.w / frameRect.h;
  const zoom = clamp(options.mapZoom ?? 1, 0.4, 5.0);
  if (mode === "custom" && options.customBounds) {
    // A map-picked crop is already the exact geographic envelope of the final
    // wind panel. NEVER reapply mapZoom or expand it to another fixed aspect:
    // that was the cause of the severe size mismatch after confirming a crop.
    const { lonMin, lonMax, latMin, latMax } = options.customBounds;
    if (![lonMin, lonMax, latMin, latMax].every(Number.isFinite) || lonMax <= lonMin || latMax <= latMin)
      throw new Error('风场图手动选区无效，请重新选择');
    return { lonMin, lonMax, latMin, latMax };
  }
  if (mode === "follow_storm") {
    const r7 = Math.max(130, meanRadius(anchor.r7));
    const latSpan = clamp((r7 / 111.12 * 5.2) / zoom, 4, 52);
    const lonSpan = latSpan * aspect;
    const centerLon = unwrapLonAround(anchor.lon, anchor.lon);
    const latMin = clamp(anchor.lat - latSpan / 2, -70, 70 - latSpan);
    return { lonMin: centerLon - lonSpan / 2, lonMax: centerLon + lonSpan / 2, latMin, latMax: latMin + latSpan };
  }
  const lonSpan = 25 / zoom;
  const latSpan = lonSpan / aspect;
  const lon = unwrapLonAround(anchor.lon, anchor.lon);
  const latMin = clamp(anchor.lat - 0.28 * latSpan, -70, 70 - latSpan);
  return {
    lonMin: lon - 0.72 * lonSpan,
    lonMax: lon + 0.28 * lonSpan,
    latMin,
    latMax: latMin + latSpan
  };
}

export function computeSynopticComputationPadding(
  bounds: SynopticBounds, gridResolutionDeg: 0.1 | 0.125 | 0.25 | 0.5, mapZoom = 1
) {
  const lonSpan = Math.max(0.5, bounds.lonMax - bounds.lonMin);
  const latSpan = Math.max(0.5, bounds.latMax - bounds.latMin);
  const viewportSpan = Math.max(lonSpan, latSpan);
  // Terrain wake can persist ~185 km (~1.7 deg). Keep a little numerical halo beyond it, but
  // scale the rest with the actual visible viewport. High zoom no longer pays for a fixed 6-deg
  // belt on all four sides; zoomed-out maps retain a wider halo for synoptic continuity.
  const wakeHalo = Math.max(2.1, gridResolutionDeg * 5);
  const viewportHalo = viewportSpan * (mapZoom > 1 ? 0.075 : 0.095);
  return clamp(Math.max(wakeHalo, viewportHalo), wakeHalo, 5.5);
}

function cubic(p0: number, p1: number, p2: number, p3: number, t: number) {
  const a0 = -0.5 * p0 + 1.5 * p1 - 1.5 * p2 + 0.5 * p3;
  const a1 = p0 - 2.5 * p1 + 2 * p2 - 0.5 * p3;
  const a2 = -0.5 * p0 + 0.5 * p2;
  return ((a0 * t + a1) * t + a2) * t + p1;
}

function sampleBicubic(field: Float32Array, nx: number, ny: number, x: number, y: number) {
  const fx = clamp(x, 0, nx - 1.001), fy = clamp(y, 0, ny - 1.001);
  const ix = Math.floor(fx), iy = Math.floor(fy), tx = fx - ix, ty = fy - iy;
  const x0 = clamp(ix - 1, 0, nx - 1);
  const x1 = clamp(ix, 0, nx - 1);
  const x2 = clamp(ix + 1, 0, nx - 1);
  const x3 = clamp(ix + 2, 0, nx - 1);
  const y0 = clamp(iy - 1, 0, ny - 1);
  const y1 = clamp(iy, 0, ny - 1);
  const y2 = clamp(iy + 1, 0, ny - 1);
  const y3 = clamp(iy + 2, 0, ny - 1);
  // ROUND108: same Catmull-Rom bicubic arithmetic as the previous loop, but with zero temporary
  // arrays. A synoptic frame performs hundreds of thousands of these samples; avoiding five new
  // JS arrays per call removes a large amount of GC work without changing resolution or formula.
  const r0 = cubic(field[y0 * nx + x0], field[y0 * nx + x1], field[y0 * nx + x2], field[y0 * nx + x3], tx);
  const r1 = cubic(field[y1 * nx + x0], field[y1 * nx + x1], field[y1 * nx + x2], field[y1 * nx + x3], tx);
  const r2 = cubic(field[y2 * nx + x0], field[y2 * nx + x1], field[y2 * nx + x2], field[y2 * nx + x3], tx);
  const r3 = cubic(field[y3 * nx + x0], field[y3 * nx + x1], field[y3 * nx + x2], field[y3 * nx + x3], tx);
  const raw = cubic(r0, r1, r2, r3, ty);
  const cx1 = Math.min(nx - 1, ix + 1), cy1 = Math.min(ny - 1, iy + 1);
  const a = field[iy * nx + ix], b = field[iy * nx + cx1], c = field[cy1 * nx + ix], d = field[cy1 * nx + cx1];
  return clamp(raw, Math.min(a, b, c, d), Math.max(a, b, c, d));
}

function sampleAtLonLat(field: SynopticWindField, values: Float32Array, lon: number, lat: number) {
  const x = (lon - field.lon0) / field.stepDeg;
  const y = (lat - field.lat0) / field.stepDeg;
  return sampleBicubic(values, field.nx, field.ny, x, y);
}

function sampleWindVectorAndSpeedAtLonLat(field: SynopticWindField, lon: number, lat: number) {
  const x = (lon - field.lon0) / field.stepDeg;
  const y = (lat - field.lat0) / field.stepDeg;
  const u = sampleBicubic(field.u10, field.nx, field.ny, x, y);
  const v = sampleBicubic(field.v10, field.nx, field.ny, x, y);
  const rawKt = Math.hypot(u, v) * 1.943844;
  const fx = clamp(x, 0, field.nx - 1.001), fy = clamp(y, 0, field.ny - 1.001);
  const ix = Math.floor(fx), iy = Math.floor(fy);
  const x1 = Math.min(field.nx - 1, ix + 1), y1 = Math.min(field.ny - 1, iy + 1);
  const a = field.speedKt[iy * field.nx + ix];
  const b = field.speedKt[iy * field.nx + x1];
  const c = field.speedKt[y1 * field.nx + ix];
  const d = field.speedKt[y1 * field.nx + x1];
  return { u, v, speedKt: clamp(rawKt, Math.min(a, b, c, d), Math.max(a, b, c, d)) };
}

function sampleWindSpeedAtLonLat(field: SynopticWindField, lon: number, lat: number) {
  return sampleWindVectorAndSpeedAtLonLat(field, lon, lat).speedKt;
}

function hash01(x: number, y: number, t: number, seed: number) {
  let h = seed ^ Math.imul((x | 0) + 0x9e3779b9, 0x85ebca6b) ^ Math.imul((y | 0) + 0x7f4a7c15, 0xc2b2ae35) ^ Math.imul((t | 0) + 0x165667b1, 0x27d4eb2d);
  h ^= h >>> 16; h = Math.imul(h, 0x7feb352d); h ^= h >>> 15; h = Math.imul(h, 0x846ca68b); h ^= h >>> 16;
  return (h >>> 0) / 4294967295;
}

function valueNoise(lat: number, lon: number, hour: number, seed: number, cellDeg: number, timeStepHours: number) {
  const x = (lon + 360) / cellDeg;
  const y = (lat + 90) / cellDeg;
  const x0 = Math.floor(x), y0 = Math.floor(y);
  const tx = smooth01(x - x0), ty = smooth01(y - y0);
  const tf = hour / Math.max(0.35, timeStepHours);
  const t0 = Math.floor(tf);
  const tt = smooth01(tf - t0);
  const spatialAt = (t: number) => {
    const a = hash01(x0, y0, t, seed), b = hash01(x0 + 1, y0, t, seed);
    const c = hash01(x0, y0 + 1, t, seed), d = hash01(x0 + 1, y0 + 1, t, seed);
    const ab = a * (1 - tx) + b * tx;
    const cd = c * (1 - tx) + d * tx;
    return ab * (1 - ty) + cd * ty - 0.5;
  };
  const a = spatialAt(t0), b = spatialAt(t0 + 1);
  return a * (1 - tt) + b * tt;
}

function fractalNoise(lat: number, lon: number, hour: number, seed: number) {
  return (
    valueNoise(lat, lon, hour, seed, 0.42, 1.8) * 1.00 +
    valueNoise(lat, lon, hour, seed ^ 0x9e3779b9, 0.88, 3.4) * 0.72 +
    valueNoise(lat, lon, hour, seed ^ 0x243f6a88, 1.70, 6.5) * 0.44 +
    valueNoise(lat, lon, hour, seed ^ 0xb7e15162, 3.20, 11.0) * 0.24
  ) / 1.34;
}

type WindEnvelope = { min: Float32Array; max: Float32Array };
/** Exactly the same 3x3 stencil and comparison order as localSpeedEnvelopeKt,
 * but evaluated once per solved grid cell, rather than for every video pixel.
 * Float32 input extrema are exactly representable in the cached arrays. */
function getWindEnvelope(field: SynopticWindField, cache: SynopticWindPressureRenderCache): WindEnvelope {
  cache.envelopeByField ||= new WeakMap();
  let cached = cache.envelopeByField.get(field);
  if (cached) return cached;
  const { nx, ny, speedKt } = field;
  const low = new Float32Array(nx * ny), high = new Float32Array(nx * ny);
  for (let iy = 0; iy < ny; iy++) {
    for (let ix = 0; ix < nx; ix++) {
      let min = Infinity, max = -Infinity;
      for (let dy = -1; dy <= 1; dy++) {
        const y = clamp(iy + dy, 0, ny - 1);
        for (let dx = -1; dx <= 1; dx++) {
          const x = clamp(ix + dx, 0, nx - 1);
          const sp = speedKt[y * nx + x];
          if (sp < min) min = sp;
          if (sp > max) max = sp;
        }
      }
      const k = iy * nx + ix;
      low[k] = min; high[k] = max;
    }
  }
  cached = { min: low, max: high };
  cache.envelopeByField.set(field, cached);
  return cached;
}

function localSpeedEnvelopeKt(field: SynopticWindField, lon: number, lat: number, cached?: WindEnvelope) {
  // ROUND107: this is a gradient detector, not a display sample. Read the nearby solved scalar
  // grid directly instead of performing nine extra bicubic vector interpolations per output pixel.
  const fx = clamp((lon - field.lon0) / field.stepDeg, 0, field.nx - 1);
  const fy = clamp((lat - field.lat0) / field.stepDeg, 0, field.ny - 1);
  const ix = Math.round(fx), iy = Math.round(fy);
  if (cached) {
    const k = iy * field.nx + ix;
    const min = cached.min[k], max = cached.max[k];
    return { min, max, spread: Math.max(0, max - min) };
  }
  let min = Infinity, max = -Infinity;
  for (let dy = -1; dy <= 1; dy++) {
    const y = clamp(iy + dy, 0, field.ny - 1);
    for (let dx = -1; dx <= 1; dx++) {
      const x = clamp(ix + dx, 0, field.nx - 1);
      const sp = field.speedKt[y * field.nx + x];
      if (sp < min) min = sp;
      if (sp > max) max = sp;
    }
  }
  return { min, max, spread: Math.max(0, max - min) };
}

function sampleDisplayWindSpeedKt(field: SynopticWindField, lon: number, lat: number, validHour: number, cachedEnvelope?: WindEnvelope) {
  // ROUND108: base display speed and direction share one bicubic vector sample. ROUND107 sampled
  // u/v once for direction and then sampled the same u/v field a second time for base speed.
  // Removing that duplicate work is numerically identical and does not change raster quality.
  const base = sampleWindVectorAndSpeedAtLonLat(field, lon, lat);
  const u = base.u, v = base.v;
  const speedMs = Math.hypot(u, v);
  const baseKt = base.speedKt;
  const envelope = localSpeedEnvelopeKt(field, lon, lat, cachedEnvelope);

  // ROUND106: suppress display-only advection/texture in strong-gradient inner cores. Without
  // this guard the visual enrichment pass could stretch eyewall colors into a narrow west/east
  // streamer that was not present in the diagnosed 10 m wind field itself.
  const speedGate = smooth01((baseKt - 8.0) / 9.0) * (1 - smooth01((baseKt - 30.0) / 10.0));
  const gradientGate = 1 - smooth01((envelope.spread - 10.0) / 14.0);
  const textureGate = clamp(speedGate * gradientGate, 0, 1);
  if (textureGate < 0.015) return Math.max(0, baseKt);

  // ROUND91: visually enrich the contour-filled wind map with smooth, irregular lobe structure.
  // The modulation is display-only and time-continuous, so exported videos gain finer texture
  // without frame-to-frame block flicker or hard jumps.
  const seedA = 0x51ed270b;
  const seedB = 0x7f4a7c15;
  const dirU = speedMs > 0.15 ? u / speedMs : 0.86;
  const dirV = speedMs > 0.15 ? v / speedMs : 0.50;
  const travelDeg = Math.min(0.16, (0.030 + 0.008 * Math.min(18, speedMs)) * (0.55 + 0.45 * textureGate));
  const advLon = lon - dirU * travelDeg;
  const advLat = lat - dirV * travelDeg;
  const warpEast = fractalNoise(advLat + 0.35, advLon - 0.28, validHour * 0.86, seedA);
  const warpNorth = fractalNoise(advLat - 0.42, advLon + 0.31, validHour * 0.92, seedB);
  const warpLon = lon + (0.070 * warpEast + 0.030 * warpNorth * dirU) * textureGate;
  const warpLat = lat + (0.070 * warpNorth + 0.030 * warpEast * dirV) * textureGate;
  const warpedKt = sampleWindSpeedAtLonLat(field, warpLon, warpLat);

  const lobeCore = fractalNoise(advLat, advLon, validHour, seedA ^ 0x68bc21eb);
  const lobeSecondary = fractalNoise(advLat * 0.92 + 0.8, advLon * 1.06 - 0.4, validHour * 1.08 + 3.5, seedB ^ 0x27d4eb2d);
  const lobeWave = Math.sin((advLon * 4.6 + advLat * 2.9 + validHour * 0.55) * Math.PI / 180)
    * Math.sin((advLon * 2.4 - advLat * 3.7 - validHour * 0.38) * Math.PI / 180);
  const lobeSignal = 0.58 * lobeCore + 0.30 * lobeSecondary + 0.12 * lobeWave;

  const warpBlend = (0.14 + 0.28 * textureGate) * gradientGate;
  const lobeAmplitudeKt = (0.18 + 0.52 * textureGate) * lobeSignal;
  const blendedKt = baseKt * (1 - warpBlend) + warpedKt * warpBlend + lobeAmplitudeKt;
  const boundedKt = clamp(blendedKt, Math.max(0, envelope.min - 0.8), envelope.max + 0.8);
  return Math.max(0, boundedKt);
}

function ktColorIndex(speed: number) {
  if (!Number.isFinite(speed) || speed <= 0) return 0;
  if (speed > 80) return 40;
  return clamp(Math.floor(Math.min(79.999999, speed) / 2), 0, 39);
}

function sampleReferenceWindRgb(speedKt: number): Rgb {
  if (!Number.isFinite(speedKt) || speedKt < REFERENCE_COLORBAR_TICKS[0]) return REFERENCE_WIND_UNDER_7_RGB;
  if (speedKt >= REFERENCE_COLORBAR_TICKS[REFERENCE_COLORBAR_TICKS.length - 1]) return REFERENCE_WIND_OVER_155_RGB;

  for (let group = 0; group < REFERENCE_COLORBAR_TICKS.length - 1; group++) {
    const lo = REFERENCE_COLORBAR_TICKS[group];
    const hi = REFERENCE_COLORBAR_TICKS[group + 1];
    if (speedKt < hi) {
      const q = clamp((speedKt - lo) / Math.max(1e-6, hi - lo), 0, 0.999999);
      const sub = Math.min(2, Math.floor(q * 3));
      return REFERENCE_WIND_BAND_RGB[group * 3 + sub];
    }
  }
  return REFERENCE_WIND_OVER_155_RGB;
}

function sampleStyleRgb(style: SynopticStyleSpec, speedKt: number): Rgb {
  if (!style.referencePalette) return KT_RGB[ktColorIndex(speedKt)];
  return sampleReferenceWindRgb(speedKt);
}

function formatUtc(date: Date) {
  const y = date.getUTCFullYear();
  const m = String(date.getUTCMonth() + 1).padStart(2, "0");
  const d = String(date.getUTCDate()).padStart(2, "0");
  const h = String(date.getUTCHours()).padStart(2, "0");
  return `${y}-${m}-${d} ${h}:00 UTC`;
}

function formatReferenceInit(date: Date) {
  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${String(date.getUTCHours()).padStart(2, "0")}z ${months[date.getUTCMonth()]} ${String(date.getUTCDate()).padStart(2, "0")} ${date.getUTCFullYear()}`;
}

function formatReferenceValid(date: Date) {
  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  const days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  return `${String(date.getUTCHours()).padStart(2, "0")}z ${days[date.getUTCDay()]}, ${months[date.getUTCMonth()]} ${String(date.getUTCDate()).padStart(2, "0")} ${date.getUTCFullYear()}`;
}

function referenceStormTag(storm: Typhoon) {
  const name = String(storm.name || "TC").trim().toUpperCase();
  const rawNo = String((storm as any).stormNumber || (storm as any).officialNumber || "").trim();
  return rawNo ? `${name}-${rawNo}` : name;
}

type Point = { x: number; y: number };
function edgePoint(edge: number, x: number, y: number, vals: number[], level: number): Point {
  const interp = (a: number, b: number) => Math.abs(b - a) < 1e-9 ? 0.5 : clamp((level - a) / (b - a), 0, 1);
  if (edge === 0) { const t = interp(vals[0], vals[1]); return { x: x + t, y }; }
  if (edge === 1) { const t = interp(vals[1], vals[2]); return { x: x + 1, y: y + t }; }
  if (edge === 2) { const t = interp(vals[3], vals[2]); return { x: x + t, y: y + 1 }; }
  const t = interp(vals[0], vals[3]); return { x, y: y + t };
}

async function contourSegments(
  values: Float32Array, nx: number, ny: number, level: number, signal?: AbortSignal,
  cellRange?: { min: Float32Array; max: Float32Array }
) {
  const table: Record<number, number[][]> = {
    1:[[3,0]],2:[[0,1]],3:[[3,1]],4:[[1,2]],5:[[3,2],[0,1]],6:[[0,2]],7:[[3,2]],
    8:[[2,3]],9:[[0,2]],10:[[0,3],[1,2]],11:[[1,2]],12:[[1,3]],13:[[0,1]],14:[[3,0]]
  };
  const segs: [Point, Point][] = [];
  for (let y = 0; y < ny - 1; y++) {
    for (let x = 0; x < nx - 1; x++) {
      // The four cell vertices cannot cross this level if the level is
      // outside the cached extrema. This only omits mask 0 / mask 15 cells:
      // marching-squares coordinates, ambiguous saddles and order remain exact.
      const cellIndex = y * (nx - 1) + x;
      if (cellRange && (level <= cellRange.min[cellIndex] || level > cellRange.max[cellIndex])) continue;
      const v0 = values[y*nx+x], v1 = values[y*nx+x+1], v2 = values[(y+1)*nx+x+1], v3 = values[(y+1)*nx+x];
      const mask = (v0 >= level ? 1 : 0) | (v1 >= level ? 2 : 0) | (v2 >= level ? 4 : 0) | (v3 >= level ? 8 : 0);
      let pairs = table[mask]; if (!pairs) continue;
      // Ambiguous marching-squares saddles (5/10) must follow the bilinear field rather than a
      // fixed diagonal.  A fixed choice creates tiny contour flips / artificial kinks when a TC
      // pressure trough merges into the environmental field.  The asymptotic decider preserves
      // the natural topology of the resampled SLP surface and is deterministic at exact ties.
      if (mask === 5 || mask === 10) {
        const a = v0 - level, b = v1 - level, c = v2 - level, d = v3 - level;
        const q = a * c - b * d;
        if (mask === 5) pairs = q >= 0 ? [[0, 1], [2, 3]] : [[3, 0], [1, 2]];
        else pairs = q <= 0 ? [[3, 0], [1, 2]] : [[0, 1], [2, 3]];
      }
      const vals = [v0,v1,v2,v3];
      for (const [a,b] of pairs) segs.push([edgePoint(a,x,y,vals,level), edgePoint(b,x,y,vals,level)]);
    }
    if (y % 8 === 7) await yieldUi(signal);
  }
  return segs;
}

async function stitchSegments(segs: [Point, Point][], signal?: AbortSignal) {
  const key = (p: Point) => Math.round(p.x * 1000) + Math.round(p.y * 1000) * 1_000_000;
  const links = new Map<number, Array<{ idx:number; end:0|1 }>>();
  for (let idx = 0; idx < segs.length; idx++) {
    const segment = segs[idx];
    for (let end = 0; end < 2; end++) {
      const k = key(segment[end]); const a = links.get(k) || [];
      a.push({ idx, end: end as 0|1 }); links.set(k, a);
    }
    if (idx % 4096 === 4095) await yieldUi(signal);
  }
  const used = new Uint8Array(segs.length); const lines: Point[][]=[];
  let linkedWork = 0;
  for (let s=0;s<segs.length;s++) if(!used[s]) {
    used[s]=1; const line=[segs[s][0],segs[s][1]];
    let changed=true;
    while(changed){ changed=false;
      for(const atStart of [false,true]){
        const p=atStart?line[0]:line[line.length-1]; const candidates=links.get(key(p))||[];
        const next=candidates.find(c=>!used[c.idx]); if(!next) continue;
        used[next.idx]=1; const seg=segs[next.idx]; const q=next.end===0?seg[1]:seg[0]; if(atStart) line.unshift(q); else line.push(q); changed=true;
        linkedWork++;
        if (linkedWork % 2048 === 0) await yieldUi(signal);
      }
    }
    if(line.length>1) lines.push(line);
    if (s % 2048 === 2047) await yieldUi(signal);
  }
  return lines;
}

function chaikin(points: Point[]) {
  if (points.length < 3) return points;
  const out: Point[]=[points[0]];
  for(let i=0;i<points.length-1;i++){
    const a=points[i],b=points[i+1];
    out.push({x:a.x*0.75+b.x*0.25,y:a.y*0.75+b.y*0.25},{x:a.x*0.25+b.x*0.75,y:a.y*0.25+b.y*0.75});
  }
  out.push(points[points.length-1]); return out;
}

const coastlineRingBoundsCache = new WeakMap<object, { lonMin:number; lonMax:number; latMin:number; latMax:number }>();
function coastlineRingBounds(ring: number[][]) {
  const cached = coastlineRingBoundsCache.get(ring as object);
  if (cached) return cached;
  let lonMin=Infinity,lonMax=-Infinity,latMin=Infinity,latMax=-Infinity;
  for (const p of ring) {
    const lon=Number(p?.[0]),lat=Number(p?.[1]);
    if (!Number.isFinite(lon)||!Number.isFinite(lat)) continue;
    lonMin=Math.min(lonMin,lon);lonMax=Math.max(lonMax,lon);latMin=Math.min(latMin,lat);latMax=Math.max(latMax,lat);
  }
  const value={lonMin,lonMax,latMin,latMax};
  coastlineRingBoundsCache.set(ring as object,value);
  return value;
}
function coastlineRingIntersects(ring: number[][], bounds: SynopticBounds) {
  const b=coastlineRingBounds(ring);
  if (b.latMax < bounds.latMin || b.latMin > bounds.latMax) return false;
  for (const shift of [-360,0,360]) {
    if (b.lonMax + shift >= bounds.lonMin && b.lonMin + shift <= bounds.lonMax) return true;
  }
  return false;
}

/** Cache the *same* projected coastline segments, preserving separate ring
 * strokes and the original source-plate seam suppression. A fixed window can
 * replay these Path2D commands for every video frame without projecting tens
 * of thousands of geographic vertices again. */
async function cachedFixedCoastPaths(
  geo: any, project: (lat: number, lon: number) => Point,
  bounds: SynopticBounds, cache: SynopticWindPressureRenderCache,
  key: string, signal?: AbortSignal
): Promise<Path2D[]> {
  if (cache.fixedCoastPaths?.key === key) return cache.fixedCoastPaths.paths;
  const paths: Path2D[] = [];
  const appendRing = (ring: number[][]) => {
    if (!coastlineRingIntersects(ring, bounds) || ring.length < 2) return;
    const path = new Path2D();
    let penDown = false, drew = false;
    for (let i=0; i<ring.length-1; i++) {
      const a=ring[i],b=ring[i+1];
      if (!a || !b || a.length<2 || b.length<2) continue;
      const aa: [number,number]=[Number(a[0]),Number(a[1])];
      const bb: [number,number]=[Number(b[0]),Number(b[1])];
      if (!Number.isFinite(aa[0]) || !Number.isFinite(aa[1]) ||
          !Number.isFinite(bb[0]) || !Number.isFinite(bb[1])) continue;
      if (isProductCoastlineSeamSegment(aa,bb)) { penDown=false; continue; }
      const pa=project(aa[1],aa[0]),pb=project(bb[1],bb[0]);
      if (![pa.x,pa.y,pb.x,pb.y].every(Number.isFinite)) { penDown=false; continue; }
      if (!penDown) path.moveTo(pa.x,pa.y);
      path.lineTo(pb.x,pb.y); penDown=true; drew=true;
    }
    if (drew) paths.push(path);
  };
  if (geo?.features) for(let fi=0;fi<geo.features.length;fi++) {
    const g=geo.features[fi].geometry;
    if(g?.type==='Polygon') g.coordinates.forEach(appendRing);
    else if(g?.type==='MultiPolygon') g.coordinates.forEach((poly:number[][][])=>poly.forEach(appendRing));
    if(fi%72===71) await yieldUi(signal);
  }
  cache.fixedCoastPaths={key,paths};
  return paths;
}

async function drawGeoJsonLines(ctx: CanvasRenderingContext2D, geo: any, project: (lat:number,lon:number)=>Point, bounds: SynopticBounds, signal?: AbortSignal) {
  if (!geo?.features) return;
  const drawPoly = (coords: number[][][]) => coords.forEach((ring) => {
    if (coastlineRingIntersects(ring, bounds)) strokeProductCoastlineRing(ctx, ring, project);
  });
  for (let fi = 0; fi < geo.features.length; fi++) {
    const f = geo.features[fi];
    const g=f.geometry; if(!g) continue;
    if(g.type==="Polygon") drawPoly(g.coordinates);
    else if(g.type==="MultiPolygon") g.coordinates.forEach(drawPoly);
    if(fi%72===71) await yieldUi(signal);
  }
}

function drawReferenceWindBarb(
  ctx: CanvasRenderingContext2D, x: number, y: number, u: number, v: number, speedKt: number, S: number, style: SynopticStyleSpec
) {
  const magnitude = Math.hypot(u, v);
  ctx.save();
  ctx.strokeStyle = style.barbColor;
  ctx.fillStyle = style.barbColor;
  // Round148: identical basic meteorological wind-barb semantics but two separately
  // calibrated silhouettes. HMON uses compact dense strokes, HWRF uses lighter glyphs.
  const glyphScale = style.barbGlyphScale;
  ctx.lineWidth = Math.max(style.barbStrokePx * S, 0.54);
  ctx.lineCap = "butt";
  ctx.lineJoin = "miter";

  if (!Number.isFinite(magnitude) || magnitude < 0.15 || speedKt < 2.5) {
    ctx.beginPath();
    ctx.arc(x, y, Math.max(1.05 * S * glyphScale, 0.9), 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();
    return;
  }

  // ROUND123 REDO: glyph geometry re-measured from the supplied Tropical Tidbits reference.
  // A clean 10-kt sample in the 1024 px reference has a ~13–14 px staff and a ~7 px feather.
  // Resolving that feather into staff coordinates gives ~6.5 px normal + ~2.7 px forward,
  // i.e. a ~68 degree feather/staff angle. 50-kt pennants use a separate, broad triangle whose
  // apex sits near the middle of its staff-side base instead of reusing the feather endpoint.
  const dx = -u / magnitude;
  const dy = v / magnitude;
  const px = -dy;
  const py = dx;

  const staff = 21.00 * S * glyphScale;
  const fullFeatherNormal = 9.75 * S * glyphScale;
  const fullFeatherForward = 4.05 * S * glyphScale;
  const halfFeatherNormal = 5.35 * S * glyphScale;
  const halfFeatherForward = 2.20 * S * glyphScale;
  const featherSpacing = 4.20 * S * glyphScale;

  // ROUND125: the standard reference uses much flatter 50-kt pennants than ROUND123/124.
  // Keep the feather geometry unchanged, but compress the filled flag normal span and its
  // staff-side footprint. Multiple pennants then sit almost shoulder-to-shoulder along the staff.
  const pennantNormal = 6.35 * S * glyphScale;
  const pennantBase = 4.75 * S * glyphScale;
  const pennantApexBack = 2.30 * S * glyphScale;
  const pennantAdvance = 4.95 * S * glyphScale;

  const tipX = x + dx * staff;
  const tipY = y + dy * staff;
  ctx.beginPath();
  ctx.moveTo(x, y);
  ctx.lineTo(tipX, tipY);
  ctx.stroke();

  let remaining = Math.max(0, Math.round(speedKt / 5) * 5);
  let cursor = 0;
  const along = (offset: number) => ({ x: tipX - dx * offset, y: tipY - dy * offset });

  while (remaining >= 50) {
    const baseFront = along(cursor);
    const baseRear = along(cursor + pennantBase);
    const apex = {
      x: baseFront.x + px * pennantNormal - dx * pennantApexBack,
      y: baseFront.y + py * pennantNormal - dy * pennantApexBack
    };
    ctx.beginPath();
    ctx.moveTo(baseFront.x, baseFront.y);
    ctx.lineTo(apex.x, apex.y);
    ctx.lineTo(baseRear.x, baseRear.y);
    ctx.closePath();
    ctx.fill();
    remaining -= 50;
    cursor += pennantAdvance;
  }

  while (remaining >= 10) {
    const a = along(cursor);
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(
      a.x + px * fullFeatherNormal + dx * fullFeatherForward,
      a.y + py * fullFeatherNormal + dy * fullFeatherForward
    );
    ctx.stroke();
    remaining -= 10;
    cursor += featherSpacing;
  }

  if (remaining >= 5) {
    const a = along(cursor);
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(
      a.x + px * halfFeatherNormal + dx * halfFeatherForward,
      a.y + py * halfFeatherNormal + dy * halfFeatherForward
    );
    ctx.stroke();
  }

  ctx.restore();
}
async function drawReferenceWindBarbs(
  ctx: CanvasRenderingContext2D, field: SynopticWindField, bounds: SynopticBounds,
  _project: (lat: number, lon: number) => Point, style: SynopticStyleSpec, S: number, mapRect: typeof MAP, signal?: AbortSignal
) {
  if (!style.windBarbs || style.barbSpacingPx <= 0) return;

  // ROUND122 REDO: the supplied reference uses a strict screen-regular wind-barb mesh.
  // Do not blue-noise scatter, jitter, stagger, collision-delete, or adaptively shrink symbols.
  const mapX = mapRect.x * S;
  const mapY = mapRect.y * S;
  const mapW = mapRect.w * S;
  const mapH = mapRect.h * S;
  const spacing = Math.max(23 * S, style.barbSpacingPx * S);
  const margin = spacing * 0.38;
  let row = 0;

  for (let y = mapY + margin; y <= mapY + mapH - margin; y += spacing, row++) {
    const fy = clamp((y - mapY) / Math.max(1, mapH), 0, 1);
    const lat = bounds.latMax - fy * (bounds.latMax - bounds.latMin);
    for (let x = mapX + margin; x <= mapX + mapW - margin; x += spacing) {
      const fx = clamp((x - mapX) / Math.max(1, mapW), 0, 1);
      const lon = bounds.lonMin + fx * (bounds.lonMax - bounds.lonMin);
      const wind = sampleWindVectorAndSpeedAtLonLat(field, lon, lat);
      if (wind.speedKt < 4) continue;
      drawReferenceWindBarb(ctx, x, y, wind.u, wind.v, wind.speedKt, S, style);
    }
    if (row % 4 === 3) await yieldUi(signal);
  }
}

export async function drawSynopticWindPressureMap(options: SynopticWindPressureMapOptions): Promise<SynopticWindField> {
  checkAbort(options.signal);
  const renderCache = options.renderCache || createSynopticWindPressureRenderCache();
  const styleSpec = SYNOPTIC_STYLE_SPECS[options.stylePreset || "default"];
  const canvas=options.canvas, S=options.outputWidth/BASE_W;
  const layout=referencePanelLayout(styleSpec.id, options.aspectRatio);
  const MAP=layout.map;
  const COLORBAR=layout.colorbar;
  const targetCanvasWidth=Math.max(640,Math.round(options.outputWidth));
  const targetCanvasHeight=Math.round(targetCanvasWidth*layout.height/BASE_W/2)*2; // WebCodecs-compatible even pixels
  // ROUND108: assigning canvas.width/height reallocates the backing store and resets the 2D
  // context even when the dimensions are unchanged. Video frames keep one resolution, so resize
  // only when necessary; every frame still repaints every output pixel exactly as before.
  if (canvas.width !== targetCanvasWidth) canvas.width=targetCanvasWidth;
  if (canvas.height !== targetCanvasHeight) canvas.height=targetCanvasHeight;
  const ctx=canvas.getContext("2d"); if(!ctx) throw new Error("Canvas 2D unavailable");
  ctx.fillStyle="#ffffff"; ctx.fillRect(0,0,canvas.width,canvas.height);
  const mapX=MAP.x*S,mapY=MAP.y*S,mapW=MAP.w*S,mapH=MAP.h*S;
  const bounds=computeSynopticDisplayBounds({ ...options, renderCache });
  const gridResolution = options.gridResolutionDeg ?? 0.25;
  const paddingDeg = computeSynopticComputationPadding(bounds, gridResolution, options.mapZoom ?? 1);
  options.onProgress?.(1);

  const field=await buildSynopticWindField({
    displayBounds:bounds, typhoons:options.typhoons, primaryTyphoon:options.primaryTyphoon,
    initHour:options.initHour, validHour:options.validHour, startDate:options.startDate, config:options.config,
    gridResolutionDeg:gridResolution, paddingDeg, roundedClearEye: options.roundedClearEye === true,
    computationCache:renderCache.computationCache, forecastHorizonHours:options.forecastHorizonHours,
    onProgress:(v)=>options.onProgress?.(Math.min(84,v)), signal:options.signal
  });
  checkAbort(options.signal);

  const centerLat=(bounds.latMin+bounds.latMax)/2, centerLon=(bounds.lonMin+bounds.lonMax)/2;
  const isPickedCrop=options.domainMode === 'custom' && !!options.customBounds;
  const ppd=MAP.w/(bounds.lonMax-bounds.lonMin);
  const projector=createPlateCarreeProjector(centerLat,wrapLon(centerLon),ppd,MAP.w,MAP.h);
  // Leaflet picks in EPSG:3857. Render the exact same screen-space window
  // rather than applying a Plate Carree ppd to Mercator-derived latitude bounds.
  // Otherwise the east/west scale may match but the north/south scale differs
  // sharply from the selection rectangle.
  const latAtRow=(t:number)=>isPickedCrop
    ? synopticCropLatitudeAtRow(bounds,t)
    : bounds.latMax-t*(bounds.latMax-bounds.latMin);
  const localProject=(lat:number,lon:number)=>isPickedCrop
    ? synopticCropProject(bounds,MAP,lat,unwrapLonAround(lon,centerLon))
    : projector.project(lat,unwrapLonAround(lon,centerLon));
  const project=(lat:number,lon:number)=>{const p=localProject(lat,lon);return{x:mapX+p.x*S,y:mapY+p.y*S};};

  // ROUND109: restore full display-space interpolation for the wind colour raster. The aggressive
  // grid-tied downsampling introduced visible blockiness in strong-gradient cores and broad bands.
  // Keep the no-quality-loss cache/buffer reuse work from ROUND107/108, but sample the display
  // raster at the actual map pixel resolution so each drawn pixel again comes from a bicubic field
  // evaluation rather than an enlarged low-resolution texture.
  const rasterW = Math.max(MAP.w, Math.round(mapW));
  const rasterH = Math.max(MAP.h, Math.round(mapH));
  const raster = renderCache.rasterCanvas || document.createElement("canvas");
  renderCache.rasterCanvas = raster;
  if (raster.width !== rasterW) raster.width = rasterW;
  if (raster.height !== rasterH) raster.height = rasterH;
  const rctx=raster.getContext("2d")!;
  if (!renderCache.rasterImageData || renderCache.rasterImageData.width !== rasterW || renderCache.rasterImageData.height !== rasterH) {
    renderCache.rasterImageData = rctx.createImageData(rasterW, rasterH);
  }
  const image=renderCache.rasterImageData; const data=image.data;
  const envelope = getWindEnvelope(field, renderCache);
  // Keep the original pixel equations/precision (Float64); only reuse their
  // invariant results for successive frames with the SAME fixed viewport.
  const coordsKey = [rasterW,rasterH,bounds.lonMin,bounds.lonMax,bounds.latMin,bounds.latMax,isPickedCrop].join('|');
  let coords = renderCache.rasterCoords;
  if (!coords || coords.key !== coordsKey) {
    const lons = new Float64Array(rasterW), lats = new Float64Array(rasterH);
    for (let px=0;px<rasterW;px++) lons[px]=bounds.lonMin+(px/Math.max(1,rasterW-1))*(bounds.lonMax-bounds.lonMin);
    for (let py=0;py<rasterH;py++) lats[py]=latAtRow(py/Math.max(1,rasterH-1));
    coords = {key:coordsKey,lons,lats};
    renderCache.rasterCoords = coords;
  }
  for(let py=0;py<rasterH;py++){
    const lat=coords.lats[py];
    for(let px=0;px<rasterW;px++){
      const lon=coords.lons[px];
      const sp=sampleDisplayWindSpeedKt(field,lon,lat,options.validHour,envelope);
      const c=sampleStyleRgb(styleSpec,sp); const k=(py*rasterW+px)*4;
      data[k]=c[0];data[k+1]=c[1];data[k+2]=c[2];data[k+3]=255;
    }
    if(py%16===15){ options.onProgress?.(84+4*(py/rasterH)); await yieldUi(options.signal); }
  }
  rctx.putImageData(image,0,0);
  ctx.save(); ctx.beginPath(); ctx.rect(mapX,mapY,mapW,mapH); ctx.clip();
  // 风速先按像素双三次插值再量化；参考图实际为 2 kt 一档（仅每 4 kt 标数字）。
  // ROUND109: 恢复插值显示。栅格已按最终地图像素级分辨率采样；若输出尺寸与栅格有极小差异，
  // 允许浏览器做高质量插值，避免 ROUND107 引入的明显马赛克块感。
  ctx.imageSmoothingEnabled=true;
  try { (ctx as any).imageSmoothingQuality = "high"; } catch {}
  ctx.drawImage(raster,mapX,mapY,mapW,mapH);

  // 等压线可独立关闭。开启时仍按真实 SLP 2× 双三次重采样后 marching squares，
  // 高精度网格不会手绘或简化成同心圆。
  if (options.showContours !== false) {
    const upFactor = field.stepDeg <= 0.125 ? 1.25 : 1.5;
    const upStep = field.stepDeg / upFactor;
    const upNx=Math.max(8,Math.ceil((bounds.lonMax-bounds.lonMin)/upStep)+1), upNy=Math.max(8,Math.ceil((bounds.latMax-bounds.latMin)/upStep)+1);
    if (!renderCache.contourValues || renderCache.contourNx !== upNx || renderCache.contourNy !== upNy) {
      renderCache.contourValues = new Float32Array(upNx * upNy);
      renderCache.contourNx = upNx; renderCache.contourNy = upNy;
    }
    const up=renderCache.contourValues; let pMin=Infinity,pMax=-Infinity;
    for(let j=0;j<upNy;j++){
      const lat=bounds.latMin+j*(bounds.latMax-bounds.latMin)/(upNy-1);
      for(let i=0;i<upNx;i++){
        const lon=bounds.lonMin+i*(bounds.lonMax-bounds.lonMin)/(upNx-1); const p=sampleAtLonLat(field,field.displaySlpHpa,lon,lat); up[j*upNx+i]=p;pMin=Math.min(pMin,p);pMax=Math.max(pMax,p);
      }
      if(j%16===15) await yieldUi(options.signal);
    }
    const contourCellCount=(upNx-1)*(upNy-1);
    if (!renderCache.contourCellMin || renderCache.contourCellMin.length !== contourCellCount) {
      renderCache.contourCellMin = new Float32Array(contourCellCount);
      renderCache.contourCellMax = new Float32Array(contourCellCount);
    }
    const cMin=renderCache.contourCellMin, cMax=renderCache.contourCellMax!;
    for(let y=0;y<upNy-1;y++) for(let x=0;x<upNx-1;x++){
      const k=y*upNx+x, at=y*(upNx-1)+x;
      const a=up[k],b=up[k+1],c=up[k+upNx],d=up[k+upNx+1];
      cMin[at]=Math.min(a,b,c,d);cMax[at]=Math.max(a,b,c,d);
    }
    const contourRange={min:cMin,max:cMax};
    const interval=options.contourIntervalHpa??4; const start=Math.ceil((pMin-1000)/interval)*interval+1000;
    ctx.strokeStyle=styleSpec.contourColor;ctx.lineWidth=styleSpec.contourWidth*S;ctx.lineJoin="round";ctx.lineCap="round";
    for(let level=start;level<=pMax+1e-6;level+=interval){
      const lines=await stitchSegments(await contourSegments(up,upNx,upNy,level,options.signal,contourRange),options.signal);
      ctx.beginPath();
      for(let line of lines){ line=chaikin(chaikin(line)); if(line.length<2)continue; for(let q=0;q<line.length;q++){
        const lon=bounds.lonMin+line[q].x/(upNx-1)*(bounds.lonMax-bounds.lonMin); const lat=bounds.latMin+line[q].y/(upNy-1)*(bounds.latMax-bounds.latMin); const p=project(lat,lon); if(q===0)ctx.moveTo(p.x,p.y);else ctx.lineTo(p.x,p.y);
      }} ctx.stroke();
      await yieldUi(options.signal);
    }
  }

  // HMON/HWRF 参考风格叠加稀疏风羽；默认风格保持原图的纯色块呈现。
  await drawReferenceWindBarbs(ctx, field, bounds, project, styleSpec, S, MAP, options.signal);

  // 风压图只绘制由高精度 land/coast 数据直接 dissolve 得到的海岸线。
  // 这里不读取任何 admin-0 / country polygon，因此不存在“国界线 + 海岸线”混合描边。
  ctx.strokeStyle=styleSpec.coastlineColor;ctx.lineWidth=(styleSpec.referenceHeader?0.88:0.75)*S;
  if (isPickedCrop && typeof Path2D !== 'undefined') {
    const coastKey = [bounds.lonMin,bounds.lonMax,bounds.latMin,bounds.latMax,MAP.x,MAP.y,MAP.w,MAP.h,S].join('|');
    const paths=await cachedFixedCoastPaths(productCoastlineGeoJson,project,bounds,renderCache,coastKey,options.signal);
    for(let i=0;i<paths.length;i++) {
      ctx.stroke(paths[i]);
      if(i%512===511) await yieldUi(options.signal);
    }
  } else await drawGeoJsonLines(ctx,productCoastlineGeoJson,project,bounds,options.signal);
  if (styleSpec.mapBorder) { ctx.strokeStyle="#161616";ctx.lineWidth=1.05*S;ctx.strokeRect(mapX,mapY,mapW,mapH); }

  if(options.showTrackOverlay){
    const issue=forecastIssueSnapshot(options.primaryTyphoon,options.initHour);
    const issueForecast=issue.forecastPath?.length?issue.forecastPath:(options.primaryTyphoon.forecastPath||[]);
    // 起报前画实况历史、起报后只画该报次几何预报，避免回溯产品偷看后来的实况轨迹。
    const pts=[...(options.primaryTyphoon.history||[]).filter(h=>h.simHour<=options.initHour+1e-6),...issueForecast.filter((p:any)=>p.simHour>options.initHour&&p.simHour<=options.validHour)];
    if(pts.length>1){
      ctx.strokeStyle=styleSpec.referenceHeader?"rgba(30,30,30,.56)":"rgba(20,20,20,.65)";ctx.lineWidth=(styleSpec.referenceHeader?1.0:1.3)*S;ctx.beginPath();
      pts.forEach((p,i)=>{const q=project(p.lat,p.lon);if(i)ctx.lineTo(q.x,q.y);else ctx.moveTo(q.x,q.y);});ctx.stroke();
      ctx.fillStyle=styleSpec.referenceHeader?"rgba(30,30,30,.70)":"rgba(20,20,20,.76)";
      pts.forEach((p,i)=>{if(i%3!==0&&i!==pts.length-1)return;const q=project(p.lat,p.lon);ctx.beginPath();ctx.arc(q.x,q.y,2.1*S,0,Math.PI*2);ctx.fill();});
    }
    // ROUND116: “历史路径”只叠加路径和节点。旧实现同时绘制 r7/r10/r12 三层虚线
    // 风圈，视觉上会多出一个（或多个）与路径无关的虚线圈，因此彻底移除该附加层。
  }

  // ROUND112: only annotate the primary tropical-cyclone centre. Synoptic highs/lows are neither
  // computed nor displayed for this product so the wind field remains uncluttered and no extra
  // H/L labels appear away from the storm centre.
  ctx.textAlign="center";ctx.textBaseline="middle";

  // 主台风标注使用产品有效时刻解析出的真实中心，而不是人为绘制的最低点。
  const primary=field.storms.find(s=>s.id===options.primaryTyphoon.id)?.state || options.primaryTyphoon;
  const cp=project(primary.lat,primary.lon); const lp=String(Math.max(0,Math.round(primary.pmin)));
  ctx.lineJoin="round";ctx.textAlign="center";ctx.textBaseline="middle";
  if (styleSpec.referenceHeader) {
    ctx.font=`800 ${26*S}px ${FONT_STACK}`;ctx.lineWidth=2.6*S;ctx.strokeStyle="rgba(255,255,255,.92)";ctx.fillStyle="#d71920";ctx.strokeText("L",cp.x,cp.y-7*S);ctx.fillText("L",cp.x,cp.y-7*S);
    ctx.font=`800 ${19*S}px ${FONT_STACK}`;ctx.strokeText(lp,cp.x,cp.y+17*S);ctx.fillText(lp,cp.x,cp.y+17*S);
  } else {
    ctx.font=`800 ${28*S}px ${FONT_STACK}`;ctx.lineWidth=3*S;ctx.strokeStyle="#7b0000";ctx.fillStyle="#ffffff";ctx.strokeText("L",cp.x,cp.y-7*S);ctx.fillText("L",cp.x,cp.y-7*S);ctx.font=`800 ${22*S}px ${FONT_STACK}`;ctx.strokeText(lp,cp.x,cp.y+20*S);ctx.fillText(lp,cp.x,cp.y+20*S);
  }
  ctx.restore();

  // 极简经纬度标注。
  const labelLon=Math.round(centerLon/10)*10,labelLat=Math.round(centerLat/10)*10;
  ctx.fillStyle="#111";ctx.font=`${17*S}px ${FONT_STACK}`;ctx.textBaseline="middle";
  ctx.textAlign="right";const latP=project(labelLat,bounds.lonMin);ctx.fillText(`${Math.abs(labelLat)}°${labelLat>=0?"N":"S"}`,55*S,latP.y);
  ctx.textAlign="center";ctx.textBaseline="top";const lonP=project(bounds.latMin,labelLon);ctx.fillText(`${Math.abs(wrapLon(labelLon))}°${wrapLon(labelLon)>=0?"E":"W"}`,lonP.x,(MAP.y+MAP.h+5)*S);

  // 标题区。默认风格维持原版；HMON/HWRF 只改变产品视觉风格，不伪造本模型没有的 850 hPa 高度场。
  const initDate=new Date(options.startDate.getTime()+options.initHour*3600_000);
  const validDate=new Date(options.startDate.getTime()+options.validHour*3600_000);
  const lead=Math.round(options.validHour-options.initHour);
  const simulatedModel=(options.modelLabel||SYNOPTIC_TITLE_MODEL_LABEL).trim()||SYNOPTIC_TITLE_MODEL_LABEL;
  const model=styleSpec.headerVariant === 'hmon' ? 'HMON-style AETHER'
    : styleSpec.headerVariant === 'hwrf' ? 'HWRF-style AETHER' : simulatedModel;
  const gridValue=options.gridResolutionDeg??0.25;
  const grid=gridValue===0.125?"0.125":gridValue.toFixed(2);
  if (!styleSpec.referenceHeader) {
    ctx.fillStyle="#111";ctx.textAlign="left";ctx.textBaseline="alphabetic";ctx.font=`${22*S}px ${FONT_STACK}`;
    ctx.fillText(`${model} ${grid}° Mean Sea Level Pressure(hpa) & 10m wind speed(kt)`,62*S,25*S);
    if (options.timePresentation === "record") {
      ctx.fillText(`Record Time:${formatUtc(validDate)} [${Math.round(options.validHour)}h]`,62*S,52*S);
    } else {
      ctx.fillText(`Forecast Time Init:${formatUtc(initDate)} [+${lead}h] Valid:${formatUtc(validDate)}`,62*S,52*S);
    }
    const minText=`Min_MSLP: ${field.minMslp.toFixed(1)} hPa`;
    const minTextWidth=ctx.measureText(minText).width;
    const minRight=Math.min(1406*S,canvas.width-8*S);
    ctx.textAlign="right";ctx.fillText(minText,Math.max(minRight,minTextWidth+8*S),52*S);
  } else {
    const stormTag=referenceStormTag(options.primaryTyphoon);
    const maxWindKt=field.maxWindMs*1.943844;
    ctx.fillStyle="#181818";ctx.textAlign="left";ctx.textBaseline="alphabetic";
    if (styleSpec.headerVariant === 'hmon') {
      // Unlike the authentic HMON sample, AETHER does not solve 850-hPa geopotential;
      // label the real 10-m wind and MSLP fields instead of inventing height contours.
      ctx.font=`700 ${20*S}px ${FONT_STACK}`;
      ctx.fillText(`${model} ${stormTag} 10m Wind (kt) & MSLP Centers (hPa)`,62*S,23*S);
      ctx.font=`${15*S}px ${FONT_STACK}`;
    } else {
      ctx.font=`700 ${19*S}px ${FONT_STACK}`;
      ctx.fillText(`${model} ${stormTag} MSLP (mb) & 10m Wind Speed (kt)`,62*S,23*S);
      ctx.font=`${15*S}px ${FONT_STACK}`;
    }
    const clockLine = options.timePresentation === 'record'
      ? `Record: [${Math.round(options.validHour)}]  valid at ${formatReferenceValid(validDate)}`
      : `Init: ${formatReferenceInit(initDate)}  Forecast Hour: [${lead}]  valid at ${formatReferenceValid(validDate)}`;
    ctx.fillText(clockLine,62*S,48*S);
    ctx.textAlign="right";ctx.fillStyle="#345ac1";ctx.font=`${14.5*S}px ${FONT_STACK}`;
    ctx.fillText(`Min MSLP: ${Math.max(0,field.minMslp).toFixed(1)}mb | Max Wind: ${Math.max(0,maxWindKt).toFixed(1)}kt`,1406*S,23*S);
    ctx.fillStyle="#999999";ctx.font=`700 ${13.5*S}px ${FONT_STACK}`;
    ctx.fillText(styleSpec.headerVariant==='hmon' ? 'HMON-STYLE • AETHER' : 'HWRF-STYLE • AETHER',1406*S,48*S);
  }

  if (layout.portrait) {
    // Horizontal legend below the wind FIELD ONLY (not inside the geographic crop).
    // Left is low wind, right is high wind, with numerical ticks that read normally.
    const bx=COLORBAR.x*S,by=COLORBAR.y*S,bw=COLORBAR.w*S,bh=COLORBAR.h*S;
    const colors = styleSpec.referencePalette ? REFERENCE_WIND_BAND_RGB : KT_RGB.slice(0,40);
    const count=colors.length + (styleSpec.referencePalette ? 2 : 1);
    const cw=bw/count;
    ctx.fillStyle='#ffffff';ctx.fillRect(bx-3*S,by-12*S,bw+8*S,bh+66*S);
    for(let i=0;i<count;i++){
      if(styleSpec.referencePalette){
        const c=i===0 ? REFERENCE_WIND_UNDER_7_RGB : i===count-1 ? REFERENCE_WIND_OVER_155_RGB : colors[i-1];
        ctx.fillStyle=`rgb(${c[0]},${c[1]},${c[2]})`;
      } else ctx.fillStyle=i===count-1 ? KT_COLORS[40] : KT_COLORS[i];
      ctx.fillRect(bx+i*cw,by,cw+.5*S,bh);
    }
    ctx.strokeStyle='#111';ctx.lineWidth=Math.max(.7,.8*S);ctx.strokeRect(bx,by,bw,bh);
    const ticks=styleSpec.referencePalette ? REFERENCE_COLORBAR_TICKS : [0,8,16,24,32,40,48,56,64,72,80];
    ctx.fillStyle='#111';ctx.font=`${14*S}px ${FONT_STACK}`;ctx.textAlign='center';ctx.textBaseline='top';
    for(const kt of ticks){
      const position=styleSpec.referencePalette
        ? (1+REFERENCE_COLORBAR_TICKS.findIndex(v=>v===kt)*3)/count
        : kt/80;
      const x=bx+bw*position;
      ctx.fillText(String(kt),x,by+bh+8*S);
    }
    ctx.font=`${15*S}px ${FONT_STACK}`;ctx.textAlign='left';
    ctx.fillText('10 m Wind (kt)  ·  左低 → 右高',bx,by-25*S);
  } else {
  const bx=COLORBAR.x*S,by=COLORBAR.y*S,bw=COLORBAR.w*S,bh=COLORBAR.h*S,cap=COLORBAR.cap*S;
  if (!styleSpec.referencePalette) {
    // 默认风格：保留原 0–80 kt、2 kt 一档的离散色标和上下端帽。
    for(let i=0;i<40;i++){const y=by+bh-(i+1)*bh/40;ctx.fillStyle=KT_COLORS[i];ctx.fillRect(bx,y,bw,bh/40+0.5*S);}
    ctx.fillStyle=KT_COLORS[40];ctx.beginPath();ctx.moveTo(bx,by);ctx.lineTo(bx+bw,by);ctx.lineTo(bx+bw/2,by-cap);ctx.closePath();ctx.fill();ctx.strokeStyle="#111";ctx.lineWidth=1*S;ctx.stroke();
    ctx.fillStyle="#ffffff";ctx.beginPath();ctx.moveTo(bx,by+bh);ctx.lineTo(bx+bw,by+bh);ctx.lineTo(bx+bw/2,by+bh+cap*0.63);ctx.closePath();ctx.fill();ctx.stroke();
    ctx.strokeStyle="#111";ctx.strokeRect(bx,by,bw,bh);ctx.font=`${17*S}px ${FONT_STACK}`;ctx.fillStyle="#111";ctx.textAlign="left";ctx.textBaseline="middle";
    for(let kt=0;kt<=80;kt+=4){const y=by+bh-(kt/80)*bh;ctx.fillText(String(kt),1460*S,y);}
    ctx.fillText("kt",1490*S,541*S);
  } else {
    // Reference legend geometry is categorical, not linear in kt. It contains one over-range cell,
    // 42 coloured cells (three per labelled interval), and one white under-range cell. Every cell
    // has identical physical height, exactly as in the supplied Tropical Tidbits image.
    const totalCells = 44;
    const cellH = bh / totalCells;

    ctx.fillStyle = `rgb(${REFERENCE_WIND_OVER_155_RGB[0]},${REFERENCE_WIND_OVER_155_RGB[1]},${REFERENCE_WIND_OVER_155_RGB[2]})`;
    ctx.fillRect(bx, by, bw, cellH + 0.6 * S);

    for (let topIndex = 0; topIndex < REFERENCE_WIND_BAND_RGB.length; topIndex++) {
      const rgb = REFERENCE_WIND_BAND_RGB[REFERENCE_WIND_BAND_RGB.length - 1 - topIndex];
      const y = by + cellH * (1 + topIndex);
      ctx.fillStyle = `rgb(${rgb[0]},${rgb[1]},${rgb[2]})`;
      ctx.fillRect(bx, y, bw, cellH + 0.6 * S);
    }

    ctx.fillStyle = `rgb(${REFERENCE_WIND_UNDER_7_RGB[0]},${REFERENCE_WIND_UNDER_7_RGB[1]},${REFERENCE_WIND_UNDER_7_RGB[2]})`;
    ctx.fillRect(bx, by + cellH * 43, bw, cellH + 0.4 * S);

    // The reference legend visibly separates every colour cell with a thin dark rule.
    ctx.strokeStyle = "rgba(18,18,18,0.78)";
    ctx.lineWidth = Math.max(0.72 * S, 0.52);
    ctx.beginPath();
    for (let i = 1; i < totalCells; i++) {
      const y = by + cellH * i;
      ctx.moveTo(bx, y);
      ctx.lineTo(bx + bw, y);
    }
    ctx.stroke();
    ctx.strokeStyle = "#111";
    ctx.lineWidth = Math.max(0.9 * S, 0.65);
    ctx.strokeRect(bx, by, bw, bh);

    ctx.font = `${15.5 * S}px ${FONT_STACK}`;
    ctx.fillStyle = "#111";
    ctx.textAlign = "left";
    ctx.textBaseline = "middle";
    const ticks = styleSpec.colorbarTicks || REFERENCE_COLORBAR_TICKS;
    ticks.forEach((kt, i) => {
      // Ascending tick i: 7 is boundary 43, 155 is boundary 1.
      const y = by + cellH * (43 - i * 3);
      ctx.fillText(String(kt), 1461 * S, y);
    });
  }

  }

  options.onProgress?.(96); await yieldUi(options.signal); return field;
}
