  "#e83f25", "#dc3321", "#b32519", "#971e13", "#5d3a20",
  "#764d37", "#9d6e58", "#cb9588", "#edc4b9", "#f6d2cb",
  "#f0a29d", "#ec7d77", "#ea635d", "#e9544a", "#e24036",
  "#d43529", "#bc2d22", "#a42217", "#851910", "#6f130b",
  "#6f140c"
] as const;
const KT_RGB = KT_COLORS.map((hex) => {
  const h = hex.replace("#", "");
  return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)] as const;
});

