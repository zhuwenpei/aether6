  return synopticProductLayout(style ?? 'default', aspect ?? 'default');
}
const FONT_STACK = 'Helvetica, Arial, "Liberation Sans", sans-serif';
// Windy 10 m wind reference palette, sampled directly from the user-supplied legend.
// The source legend uses 2 kt color slabs (labels are shown every 4 kt), not 4 kt slabs.
// Each entry below is the robust center-strip median of one 2 kt slab, from 0–2 through 78–80 kt.
// The final entry is the >80 kt triangular cap sampled from the same reference.
const KT_COLORS = [
  "#fefefe", "#e5e5e5", "#cbcacb", "#ababab", "#828180",
  "#595857", "#265bee", "#3477f5", "#4e9cf6", "#79c6f8",
  "#a2f0fb", "#63cf47", "#78ef5a", "#86f76c", "#c0fab4",
